# =============================================================================
# Fuel Supply Intelligence & Resilience Platform — backend configuration
# =============================================================================
#
# HOW TO USE THIS FILE
# --------------------
#   1. Copy it:              cp backend/.env.example backend/.env
#   2. Fill in the values you need (only DEEPSEEK_API_KEY is truly optional).
#   3. Run the backend from the `backend/` directory, because `app.config`
#      loads a `.env` file relative to the working directory.
#
# `backend/.env` IS GIT-IGNORED. It never gets committed and it is the only
# file that should ever hold a real secret. This file — `.env.example` — is the
# committed template and must contain no real value, ever.
#
# Every variable below has a default in `app/config.py` (CONTRACT.md section 4),
# so the service boots with none of them set. Anything you omit falls back to
# the default shown in the comment.
#
# The platform talks ONLY to the BUP Fuel Supply Simulator. It never contacts
# real fuel infrastructure (brief section 24).
# =============================================================================


# --- Simulator gateway -------------------------------------------------------
# Root URL of the published simulator. In docker compose this is the service
# name on the compose network. For a simulator running on your machine use
# http://localhost:8001. Default: http://simulator-api:8000
SIMULATOR_BASE_URL=http://simulator-api:8000

# Per-request timeout, in seconds, for every HTTP call to the simulator.
# Default: 10
SIMULATOR_TIMEOUT_SECONDS=10

# How many times a simulator request is retried. Retries apply to 5xx responses
# and transport errors only — never to a 4xx, which is not a transient failure.
# Default: 3
SIMULATOR_MAX_RETRIES=3

# Consecutive failures tolerated before the circuit breaker opens. While open,
# reads are served from the last-good cache and marked `stale: true`.
# Default: 5
CIRCUIT_FAILURE_THRESHOLD=5

# How long the breaker stays open before it allows a single half-open trial
# request, in seconds. Default: 30
CIRCUIT_RESET_SECONDS=30


# --- Storage -----------------------------------------------------------------
# SQLAlchemy async database URL. SQLite needs no infrastructure and works in
# compose as-is. Swap the scheme for Postgres (e.g.
# postgresql+asyncpg://user:password@host/db) without touching any code.
# NOTE: if this URL carries a password, that password is a secret — keep this
# line in `backend/.env`, never here. Default:
# sqlite+aiosqlite:///./data/fuel.db
DATABASE_URL=sqlite+aiosqlite:///./data/fuel.db


# --- DeepSeek LLM ------------------------------------------------------------
# SECRET — leave this EMPTY here and in any committed file.
#
# The key lives only in `backend/.env` (git-ignored) or in the deployment's
# environment/secret store. It is used solely in the Authorization header of
# the DeepSeek request: it is never logged, never echoed in an error message,
# never returned by an endpoint, never used as a metric label, and never sent
# to the model.
#
# When it is empty the platform does NOT fail. `Settings.llm_available` becomes
# False and every explanation is produced by the deterministic template
# fallback, with `source="fallback"` and `degraded=true` in the response. That
# is a supported operating mode (brief section 11), not an error, and
# /api/v1/status reports the LLM component as "degraded" rather than "down".
#
# Default: empty
DEEPSEEK_API_KEY=

# DeepSeek's OpenAI-compatible API root. The client appends
# `/chat/completions`; do not include that path here.
# Default: https://api.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Model id passed in the request body. Default: deepseek-chat
DEEPSEEK_MODEL=deepseek-chat

# Timeout, in seconds, for one LLM completion. On timeout the explanation
# service retries once and then falls back to the deterministic template.
# Default: 30
DEEPSEEK_TIMEOUT_SECONDS=30

# Master switch for the LLM path. Set to false to force the deterministic
# fallback everywhere — useful for demos, for CI, and for showing the
# degradation behaviour on purpose. Note that true is not enough on its own:
# the key must also be present for `llm_available` to be true.
# Default: true
LLM_ENABLED=true


# --- API ---------------------------------------------------------------------
# Port the FastAPI/uvicorn server listens on. Default: 9000
API_PORT=9000

# Log verbosity for the structlog JSON pipeline. One of DEBUG, INFO, WARNING,
# ERROR or CRITICAL. Default: INFO
LOG_LEVEL=INFO

# Comma-separated list of browser origins allowed to call this API. The backend
# is the single gateway, so this is only needed when the console is served from
# a different origin than the API (CORS never applies to server-to-server
# calls). Keep the list narrow — "*" with credentials is a security smell.
# Default: http://localhost:8080,http://localhost:5173
CORS_ALLOW_ORIGINS=http://localhost:8080,http://localhost:5173
