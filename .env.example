# Environment template for the Docker Compose stack.
#
#   cp .env.example .env      # then edit .env
#   docker compose up --build
#
# `.env` is git-ignored. This file is the committed template and must never
# contain a real secret.
#
# This file configures the *containers*. When you run the backend directly with
# uvicorn instead of Docker, it reads `backend/.env` — see `backend/.env.example`
# for that one. The two cover the same settings for two different run modes.

# --- the one secret --------------------------------------------------------
# Official DeepSeek API key. Leave it EMPTY to run everything except the
# generative explanations.
#
# Empty is a supported mode, not a broken state: the explanation service falls
# back to a deterministic templated explanation built from the same structured
# facts, and reports `source: "fallback"` so the operator can see the difference
# (brief §11, "ML model unavailable → fallback").
#
# This is passed to the container at runtime, never as a build argument, so it
# cannot end up baked into an image layer.
# NOTE: this file is COMMITTED. It must never contain a real key — put yours in
# `.env` (git-ignored), which `docker compose` reads automatically.
DEEPSEEK_API_KEY=

# Set to false to force the fallback path even when a key is present. Useful for
# demonstrating the degradation behaviour deliberately.
LLM_ENABLED=true

# --- ports -----------------------------------------------------------------
# Host port for the backend API (Swagger UI at http://localhost:<port>/docs).
BACKEND_HOST_PORT=9000

# Host port for the operator console.
# (The console is published on a fixed 8080:80 mapping; change it in
# docker-compose.yml if it collides.)

# Host port for the simulator's own API and /admin dashboard.
# 8000 is frequently already taken by another local service — if `up` fails with
# "port is already allocated", set this to 8001. The frontend and backend are
# unaffected either way: both reach the simulator over the compose network.
SIMULATOR_HOST_PORT=8000

# --- simulation ------------------------------------------------------------
# Wall-clock ticks per second while the simulator is running.
SIMULATION_SPEED=8

# Simulated minutes advanced per tick.
TICK_MINUTES=15

# "running" or "paused". Defaulted to running so the stack is immediately
# useful; the simulator's own default is paused, which leaves it at tick 0.
SIMULATOR_START_MODE=running

# --- stockout / shortage intelligence --------------------------------------
# These tune the per-(station, fuel) inventory projection and the bands that
# turn it into a risk level. The stack runs on the defaults; set them only to
# match the network you are watching.

# How many simulated ticks ahead the inventory projection runs. One tick is
# TICK_MINUTES of simulated time, so the default of 8 is two simulated hours.
STOCKOUT_HORIZON_TICKS=8

# Ticks-to-stockout at or below which risk is CRITICAL — the station is dry now
# or before the next tick, so nothing can reach it in time.
STOCKOUT_CRITICAL_TICKS=1.0

# Ticks-to-stockout at or below which risk is HIGH: still actionable, but only
# on this reading rather than the next one. Keep it above
# STOCKOUT_CRITICAL_TICKS.
STOCKOUT_HIGH_TICKS=3.0

# Safety stock as a fraction of the horizon's expected demand. Below it, with no
# projected stockout, risk is MEDIUM: no cushion left for the next spike.
STOCKOUT_SAFETY_STOCK_FRACTION=0.25

# --- logging ---------------------------------------------------------------
LOG_LEVEL=INFO
